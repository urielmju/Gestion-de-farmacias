@model PIV_PF_ProyectoFinal.ViewModels.UsuarioViewModel

@{
    ViewBag.Title = "Nuevo usuario";
}

<h1 class="page-title">Nuevo usuario</h1>
<p class="page-subtitle">Complete los datos del usuario que desea registrar.</p>

@using (Html.BeginForm("Create", "Usuarios", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="form-panel">
        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

        <div class="form-group">
            @Html.LabelFor(m => m.Identificacion)
            @Html.TextBoxFor(m => m.Identificacion, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Identificacion)
            <small style="color:var(--text-muted);">Codigo generado automaticamente, puede modificarlo.</small>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.NombreCompleto)
            @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control", placeholder = "Ej: Juan Perez Rodriguez" })
            @Html.ValidationMessageFor(m => m.NombreCompleto)
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Correo)
            @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", type = "email", placeholder = "ejemplo@correo.com" })
            @Html.ValidationMessageFor(m => m.Correo)
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Contrasena)
            @Html.PasswordFor(m => m.Contrasena, new { @class = "form-control", placeholder = "Min. 6 caracteres, un numero y un caracter especial" })
            @Html.ValidationMessageFor(m => m.Contrasena)
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.TipoUsuario)
            @Html.DropDownListFor(m => m.TipoUsuario, (SelectList)ViewBag.TiposUsuario,
                "-- Seleccione un tipo --", new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.TipoUsuario)
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Estado)
            @Html.DropDownListFor(m => m.Estado, (SelectList)ViewBag.Estados,
                "-- Seleccione un estado --", new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Estado)
        </div>

        <div class="form-actions">
            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-check"></i> Guardar usuario
            </button>
        </div>
    </div>
}