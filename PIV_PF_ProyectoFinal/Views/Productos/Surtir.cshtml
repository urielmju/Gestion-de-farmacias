@model PIV_PF_ProyectoFinal.ViewModels.SurtirViewModel

@{
    ViewBag.Title = "Surtir producto";
}

<h1 class="page-title">Surtir producto</h1>
<p class="page-subtitle">Agregue unidades al inventario del producto seleccionado.</p>

@using (Html.BeginForm("Surtir", "Productos", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.CodigoProducto)

    <div class="form-panel">
        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

        <div class="form-group">
            <label>Producto</label>
            <div class="form-control" style="background-color:#0f1418;">
                @Model.CodigoProducto — @Model.Descripcion
            </div>
        </div>

        <div class="form-group">
            <label>Cantidad actual en inventario</label>
            <div class="form-control" style="background-color:#0f1418;">
                @Model.CantidadActual unidades
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.CantidadAgregar)
            @Html.TextBoxFor(m => m.CantidadAgregar, new
            {
                @class = "form-control",
                type = "number",
                min = "1",
                placeholder = "Ej: 50"
            })
            @Html.ValidationMessageFor(m => m.CantidadAgregar)
        </div>

        <div class="form-actions">
            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-boxes-stacking"></i> Surtir
            </button>
        </div>
    </div>
}