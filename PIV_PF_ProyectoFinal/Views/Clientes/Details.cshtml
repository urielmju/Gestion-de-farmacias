@*
    Vista: Views/Clientes/Details.cshtml
    Muestra los datos completos de un cliente especifico.
*@
@model PIV_PF_ProyectoFinal.ViewModels.ClienteViewModel

@{
    ViewBag.Title = "Detalles del cliente";
}

<h1 class="page-title">Detalles del cliente</h1>

<div class="form-panel">
    <div class="form-group">
        <label>Identificación</label>
        <div class="form-control" style="background-color:#0f1418;">@Model.Identificacion</div>
    </div>

    <div class="form-group">
        <label>Nombre completo</label>
        <div class="form-control" style="background-color:#0f1418;">@Model.NombreCompleto</div>
    </div>

    <div class="form-group">
        <label>Correo electrónico</label>
        <div class="form-control" style="background-color:#0f1418;">@Model.Correo</div>
    </div>

    <div class="form-group">
        <label>Fecha de registro</label>
        <div class="form-control" style="background-color:#0f1418;">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</div>
    </div>

    <div class="form-actions">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Volver
        </a>
        <a href="@Url.Action("Edit", new { id = Model.IdCliente })" class="btn btn-primary">
            <i class="fa-solid fa-pen"></i> Editar
        </a>
    </div>
</div>