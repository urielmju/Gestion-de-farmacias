@*
    Vista: Views/Clientes/Index.cshtml
    Muestra el listado de clientes registrados.
*@
@model IEnumerable<PIV_PF_ProyectoFinal.ViewModels.ClienteViewModel>

@{
    ViewBag.Title = "Clientes";
}

<div class="toolbar">
    <div>
        <h1 class="page-title">Clientes</h1>
        <p class="page-subtitle">Listado de todos los clientes registrados en el sistema.</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> Nuevo cliente
    </a>
</div>

<div class="data-panel">
    <table class="data-table">
        <thead>
            <tr>
                <th>Identificación</th>
                <th>Nombre completo</th>
                <th>Correo electrónico</th>
                <th>Fecha de registro</th>
                <th style="text-align:right;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" style="text-align:center; padding:28px; color:var(--text-muted);">
                        No hay clientes registrados.
                    </td>
                </tr>
            }
            else
            {
                foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.Identificacion</td>
                        <td>@cliente.NombreCompleto</td>
                        <td>@cliente.Correo</td>
                        <td>@cliente.FechaRegistro.ToString("dd/MM/yyyy")</td>
                        <td style="text-align:right;">
                            <a href="@Url.Action("Details", new { id = cliente.IdCliente })"
                               class="btn btn-secondary btn-sm" title="Ver detalles">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                            <a href="@Url.Action("Edit", new { id = cliente.IdCliente })"
                               class="btn btn-primary btn-sm" title="Editar">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div style="margin-top:20px;">
    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left"></i> Volver al inicio
    </a>
</div>