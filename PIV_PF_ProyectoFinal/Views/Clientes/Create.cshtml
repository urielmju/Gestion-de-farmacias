@*
    Vista: Views/Clientes/Create.cshtml
    Formulario para registrar un nuevo cliente.
*@
@model PIV_PF_ProyectoFinal.ViewModels.ClienteViewModel

@{
    ViewBag.Title = "Nuevo cliente";
}

<h1 class="page-title">Nuevo cliente</h1>
<p class="page-subtitle">Complete los datos del cliente que desea registrar.</p>

@using (Html.BeginForm("Create", "Clientes", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-panel">

        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

        <div class="form-group">
            @Html.LabelFor(m => m.Identificacion)
            @Html.TextBoxFor(m => m.Identificacion, new { @class = "form-control", placeholder = "Ej: 102340567" })
            @Html.ValidationMessageFor(m => m.Identificacion)
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.NombreCompleto)
            @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control", placeholder = "Ej: Juan Pérez Rodríguez" })
            @Html.ValidationMessageFor(m => m.NombreCompleto)
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Correo)
            @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", type = "email", placeholder = "ejemplo@correo.com" })
            @Html.ValidationMessageFor(m => m.Correo)
        </div>

        <div class="form-actions">
            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-check"></i> Guardar cliente
            </button>
        </div>
    </div>
}